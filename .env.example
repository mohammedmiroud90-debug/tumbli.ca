# Copy these values from the shared Libertta.Blog backend configuration.
PARSE_SERVER_URL=
PARSE_APP_ID=
PARSE_JAVASCRIPT_KEY=
# Required if the Parse Comment/BlogComment collections deny public creates.
# Keep this server-only; never expose it through NEXT_PUBLIC_ variables.
PARSE_MASTER_KEY=

# Optional: HTTPS origin for your production CDN, for example
# NEXT_PUBLIC_CDN_URL=https://cdn.example.com
NEXT_PUBLIC_CDN_URL=

# Public canonical URL used for metadata, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://tumbli.eu.cc
